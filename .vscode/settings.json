{
    "prisma.pinToPrisma6": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.next/**": true,
        "**/_OS_BACKUP_STORAGE/**": true,
        "**/_archive/**": true,
        "**/.checkpoints/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.next": true,
        "**/_OS_BACKUP_STORAGE": true,
        "**/_archive": true,
        "**/.checkpoints": true,
        "*.exe": true
    }
}